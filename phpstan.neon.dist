includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    level: 8
    ignoreErrors:
        # Larastan cannot resolve views registered under the package's view namespace.
        -
            identifier: argument.type
            message: '#view-string\|null, string given#'
            path: src/Http/Controllers
    paths:
        - src
        - database
        - routes
