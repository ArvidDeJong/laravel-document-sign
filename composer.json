{
    "name": "darvis/laravel-document-sign",
    "description": "Sign PDF documents in Laravel with a DocuSign like flow: invite signers by mail, capture a drawn signature and stamp it on the PDF with a full audit trail.",
    "keywords": [
        "laravel",
        "pdf",
        "signature",
        "document-signing",
        "docusign"
    ],
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Arvid",
            "email": "facturen@darvis.nl"
        }
    ],
    "require": {
        "php": "^8.3",
        "illuminate/contracts": "^12.0",
        "setasign/fpdf": "^1.8.6",
        "setasign/fpdi": "^2.6"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0",
        "pestphp/pest": "^3.0",
        "pestphp/pest-plugin-laravel": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "Darvis\\Signer\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Darvis\\Signer\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/pest"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Darvis\\Signer\\SignerServiceProvider"
            ],
            "aliases": {
                "Signer": "Darvis\\Signer\\Facades\\Signer"
            }
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
