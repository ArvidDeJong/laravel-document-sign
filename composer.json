{
    "name": "darvis/laravel-document-sign",
    "description": "Sign PDF documents in Laravel with a DocuSign like flow: invite signers by mail, capture a drawn signature and stamp it on the PDF with a full audit trail.",
    "keywords": [
        "laravel",
        "pdf",
        "signature",
        "e-signature",
        "document-signing",
        "docusign",
        "audit-trail",
        "laravel-boost"
    ],
    "type": "library",
    "license": "MIT",
    "homepage": "https://arviddejong.github.io/laravel-document-sign/",
    "authors": [
        {
            "name": "Arvid de Jong",
            "email": "info@arvid.nl"
        }
    ],
    "support": {
        "issues": "https://github.com/ArvidDeJong/laravel-document-sign/issues",
        "source": "https://github.com/ArvidDeJong/laravel-document-sign"
    },
    "require": {
        "php": "^8.2",
        "ext-gd": "*",
        "laravel/framework": "^11.0|^12.0|^13.0",
        "setasign/fpdf": "^1.8.6",
        "setasign/fpdi": "^2.6"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.0",
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "pestphp/pest": "^3.0|^4.0",
        "pestphp/pest-plugin-laravel": "^3.0|^4.0",
        "phpunit/phpunit": "^11.0|^12.0|^13.0"
    },
    "autoload": {
        "psr-4": {
            "Darvis\\Signer\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Darvis\\Signer\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Darvis\\Signer\\SignerServiceProvider"
            ],
            "aliases": {
                "Signer": "Darvis\\Signer\\Facades\\Signer"
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "sort-packages": true
    },
    "scripts": {
        "test": "pest",
        "lint": "pint --test",
        "format": "pint",
        "analyse": "phpstan analyse --memory-limit=1G"
    }
}
